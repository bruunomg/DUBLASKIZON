# Exemplo sem chave real. Use IMPORTAR .env na janela de APIs.
# IDs abaixo sao exemplos; confirme acesso com CONSULTAR MODELOS.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CODEX_MODEL=gpt-5-codex

# Outros provedores (descomente e preencha quando quiser usar):
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_API_KEY=
# GEMINI_MODEL=

# Tambem reconhece OPENAI_CODEX_MODEL, LUNA_TRANSLATION_MODEL e SOL_REVIEW_MODEL.
# Campos vazios nao apagam uma chave/modelo existente durante a importacao.
